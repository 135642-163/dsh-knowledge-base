{
  "name": "dsh-knowledge-wiki",
  "version": "0.24.0",
  "description": "DeepSeek Harness 插件：把 Word/PPT/PDF（文字版与扫描版）资料整理为适合大模型阅读的知识库，支持检索、精读、修订、导出",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/135642-163/dsh-knowledge-base.git"
  },
  "homepage": "https://github.com/135642-163/dsh-knowledge-base#readme",
  "bugs": {
    "url": "https://github.com/135642-163/dsh-knowledge-base/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "knowledge-base",
    "rag",
    "pdf",
    "docx",
    "ocr"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/build-client.mjs --check && node scripts/check-ui.mjs && node scripts/run-tests.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib",
    "ui",
    "worker",
    "data/rapidocr",
    "data/tesseract",
    "data/win",
    "cordis.patch.yml",
    "install-to-machine.sh",
    "install-to-machine.ps1",
    "README.md",
    "LICENSE",
    "vendor"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@vscode/ripgrep": "^1.18.0",
    "bmp-js": "^0.1.0",
    "fast-xml-parser": "^4.5.0",
    "iconv-lite": "^0.6.3",
    "idb-keyval": "^6.2.0",
    "is-url": "^1.2.4",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "mupdf": "^1.5.1",
    "node-fetch": "^2.6.9",
    "regenerator-runtime": "^0.13.3",
    "tesseract.js-core": "^6.0.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "wasm-feature-detect": "^1.2.11",
    "zlibjs": "^0.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
